{
  "rules": {
    ".read": false,
    ".write": false,

    "users": {
      "$uid": {
        ".read": "auth != null",
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    
    "profiles": {
      "$uid": {
        ".read": "auth != null",
        ".write": "auth != null && auth.uid === $uid"
      }
    },

    "user_locations": {
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || data.child('viewers').child(auth.uid).val() === true)",
        ".write": "auth != null && auth.uid === $uid"
      }
    },

    "location_shares": {
      "$shareId": {
        ".read": "auth != null && (data.child('requesterId').val() === auth.uid || data.child('recipientId').val() === auth.uid)",
        ".write": "auth != null && ((!data.exists() && newData.child('requesterId').val() === auth.uid && newData.child('recipientId').val() !== auth.uid) || (data.exists() && (data.child('requesterId').val() === auth.uid || data.child('recipientId').val() === auth.uid)))"
      }
    }
  }
}
