{
  "rules": {
    "location_requests": {
      "$uid": {
        "incoming": {
          "$requesterId": {
            ".read": "$uid === auth.uid",
            ".write": "($uid === auth.uid) || ($requesterId === auth.uid && !root.child('blocks').child($uid).child($requesterId).exists() && !root.child('blocks').child($requesterId).child($uid).exists())"
          }
        },
        "outgoing": {
          "$recipientId": {
            ".read": "$uid === auth.uid",
            ".write": "($uid === auth.uid) || ($recipientId === auth.uid && !root.child('blocks').child($uid).child($recipientId).exists() && !root.child('blocks').child($recipientId).child($uid).exists())"
          }
        }
      }
    },
    "user_locations": {
      "$uid": {
        ".read": "auth != null",
        ".write": "$uid === auth.uid"
      }
    },
    "blocks": {
      "$blockerId": {
        "$blockedId": {
          ".read": "$blockerId === auth.uid || $blockedId === auth.uid",
          ".write": "$blockerId === auth.uid"
        }
      }
    }
  }
}
