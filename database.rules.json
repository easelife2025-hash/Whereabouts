{
  "rules": {
    "location_requests": {
      "$uid": {
        ".read": "$uid === auth.uid",
        "incoming": {
          "$requesterId": {
            ".write": "($uid === auth.uid) || ($requesterId === auth.uid)"
          }
        },
        "outgoing": {
          "$recipientId": {
            ".write": "($uid === auth.uid) || ($recipientId === auth.uid)"
          }
        }
      }
    },
    "user_locations": {
      "$uid": {
        ".read": "auth != null",
        ".write": "$uid === auth.uid"
      }
    },
    "blocks": {
      "$blockerId": {
        "$blockedId": {
          ".read": "$blockerId === auth.uid || $blockedId === auth.uid",
          ".write": "$blockerId === auth.uid"
        }
      }
    }
  }
}
