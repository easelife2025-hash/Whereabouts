rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Users Collection
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Location Shares Collection
    match /location_shares/{shareId} {
      // The person sharing their location can manage their own shares
      allow create: if request.auth != null && request.auth.uid == request.resource.data.recipientId;
      allow update, delete: if request.auth != null && request.auth.uid == resource.data.recipientId;
      
      // Reading permissions:
      allow read: if request.auth != null && (
        // 1. The person sharing can always see their outgoing shares
        request.auth.uid == resource.data.recipientId ||
        // 2. The requester can see it ONLY if it's active and not expired
        (
          request.auth.uid == resource.data.requesterId &&
          resource.data.status == 'active' &&
          (resource.data.expiresAt == null || request.time < resource.data.expiresAt)
        )
      );
    }
  }
}
