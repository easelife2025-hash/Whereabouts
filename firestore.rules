rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Users Collection
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Location Shares Collection
    match /location_shares/{shareId} {
      // The person sharing their location can manage their own shares
      allow create: if request.auth != null && request.auth.uid == request.resource.data.recipientId;
      allow update, delete: if request.auth != null && request.auth.uid == resource.data.recipientId;
      
      // Reading permissions:
      allow read: if request.auth != null && (
        request.auth.uid == resource.data.recipientId ||
        request.auth.uid == resource.data.requesterId
      );
    }
  }
}
