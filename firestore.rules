rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    function getBlockedUsers(userId) {
      let userDoc = get(/databases/$(database)/documents/users/$(userId));
      return (userDoc != null && 'blockedUsers' in userDoc.data) ? userDoc.data.blockedUsers : [];
    }

    // Users Collection
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Location Shares Collection
    match /location_shares/{shareId} {
      allow create: if request.auth != null && 
        request.auth.uid == request.resource.data.recipientId &&
        !(request.auth.uid in getBlockedUsers(request.resource.data.requesterId)) &&
        !(request.resource.data.requesterId in getBlockedUsers(request.auth.uid));
      
      allow update, delete: if request.auth != null && request.auth.uid == resource.data.recipientId;
      
      allow read: if request.auth != null && (
        request.auth.uid == resource.data.recipientId ||
        request.auth.uid == resource.data.requesterId
      );
    }

    // Location Requests Collection (Migrated from RTDB)
    match /location_requests/{requestId} {
      allow create: if request.auth != null && 
        request.auth.uid == request.resource.data.senderId &&
        !(request.auth.uid in getBlockedUsers(request.resource.data.recipientId)) &&
        !(request.resource.data.recipientId in getBlockedUsers(request.auth.uid));
      
      allow update, delete: if request.auth != null && (
        request.auth.uid == resource.data.senderId ||
        request.auth.uid == resource.data.recipientId
      );

      allow read: if request.auth != null && (
        request.auth.uid == resource.data.senderId ||
        request.auth.uid == resource.data.recipientId
      );
    }

    // User Locations (Migrated from RTDB)
    match /user_locations/{userId} {
      allow write: if request.auth != null && request.auth.uid == userId;
      allow read: if request.auth != null && (
        request.auth.uid == userId ||
        (resource == null) ||
        (request.auth.uid in resource.data.viewers)
      );
    }
  }
}
